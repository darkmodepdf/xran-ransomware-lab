FROM python:3.12.16-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df

RUN python -m pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu 'torch==2.15.0+cpu'

WORKDIR /app
COPY src/raneval/*.py ./raneval/
COPY demo/runner.py demo/model_adapter.py ./
USER 10001:10001
ENV TMPDIR=/tmp HOME=/tmp

ENTRYPOINT ["python", "-B", "-u", "/app/runner.py"]
